{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# Listen on IPv4 and IPv6 separately: Railway's health check and edge can use either.
	bind 0.0.0.0 [::]
	root * /srv
	encode zstd gzip
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	file_server
}
