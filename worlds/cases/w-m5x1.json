        "role": "registry of tenant records; sites own app records"
      },
      {
        "name": "cleanup-job",
        "role": "reads an ID list and asks lifecycle-api to remove each record"
      },
      {
        "name": "lifecycle-api",
        "role": "removes a registry record by ID"
      }
    ],
