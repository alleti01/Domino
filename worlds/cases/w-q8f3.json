  "describe": {
    "title": "Remove the retired reports add-on from migrated tenants",
    "components": [
      {
        "name": "tenant-registry",
        "role": "registry of tenant records; sites own app records"
      },
      {
        "name": "cleanup-job",
        "role": "reads an ID list and asks lifecycle-api to remove each record"
      },
      {
        "name": "lifecycle-api",
        "role": "removes a registry record by ID"
      }
    ],
    "change": {
      "entity_id": "w-q8f3/change/0187",
      "title": "Remove the retired reports add-on from migrated tenants",
