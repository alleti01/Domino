# Meterless Nightshift runtime (copy to .env; never commit .env)
# Base URL from the Nightshift Console. Any pasted form is normalised to <host>/v1.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Runtime token from the Nightshift Console. If unset, it's read from
# ~/Library/Application Support/ai.meterless.nightshift.m1m4/runtime-token (Mac M1–M4)
# or ~/Library/Application Support/ai.meterless.runtime/proxy-token
METERLESS_RUNTIME_TOKEN=
# Routing mode or model id. Keep only Nemotron lanes seated in Nightshift.
METERLESS_MODEL=meterless/auto
# Fail any call whose receipt shows a non-Nemotron model (for NVIDIA award evidence).
REQUIRE_NEMOTRON=true
