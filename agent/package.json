{
  "name": "domino-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domino investigation agent: Nemotron via Meterless Nightshift.",
  "bin": {
    "domino-check": "bin/domino.mjs",
    "domino": "bin/domino.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "smoke": "tsx scripts/smoke.ts",
    "test": "DOMINO_MIN_CALL_INTERVAL_MS=0 vitest run",
    "typecheck": "tsc --noEmit",
    "investigate": "tsx src/cli.ts run",
    "conformance:world-model": "WORLD_MODEL_IMPL=\"$PWD/vendor/meterless-world-model/src/index.ts\" tsx vendor/meterless-world-model/conformance/runner.ts",
    "eval": "tsx scripts/practice-eval.ts",
    "replay": "tsx src/cli.ts replay",
    "demo": "tsx src/cli.ts demo",
    "report": "tsx src/cli.ts report",
    "doctor": "tsx src/cli.ts doctor"
  },
  "dependencies": {
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
