# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Variables already exported in your shell win over this file:
# check with  env | grep -e ZETARIS -e DOMINO

# Where lookups and experiments get their data: fake | sample | live
#   fake   = canned contract samples, for building against before Zetaris is ready
#   sample = saved Zetaris query snapshots, no Zetaris or keys needed (judges' mode)
#   live   = real queries against your local Zetaris
DOMINO_DATA_MODE=fake

# Zetaris UI origin (the API proxy lives under it) and your real org ID
# (Management -> Organisation; usually 1 on a local install, but check)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1

# Admin login: setup only (register sources, COMPILE USL, RUN DQ, grants).
# The agent never uses it.
ZETARIS_ADMIN_USERNAME=
ZETARIS_ADMIN_PASSWORD=

# Read-only, non-admin login used by lookup() and dependency_path().
# Create it in the Zetaris UI and set its password there (the REST password change is buggy).
ZETARIS_AGENT_USERNAME=
ZETARIS_AGENT_PASSWORD=

# Per-request timeout and row cap
ZETARIS_TIMEOUT_S=30
ZETARIS_QUERY_LIMIT=1000

# Evidence: every query is appended here (SQL, row IDs, timing)
DOMINO_QUERY_LOG=runs/query_log.jsonl

# 1 = save each live lookup result as a sample-mode snapshot
DOMINO_SNAPSHOT_WRITE=0
