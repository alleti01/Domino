  "hypotheses": [
    {
      "hypothesis_id": "h1",
      "claim": "The explicit GRANT SELECT ON r0.* TO svc_bundle_reader gives the principal access to ALL tables in database r0, not just bundle_fields. This causes the bundle-builder to discover 280 rows (instead of 140), exceeding the worker-runtime.max_entries=200 limit and causing the worker to refuse to start.",
      "mechanism": "GRANT SELECT ON r0.* → svc_bundle_reader can see all tables in r0 → bundle-builder queries all tables and counts 280 rows → worker-runtime max_entries=200 limit exceeded → worker-runtime.exit_code=2 (fatal: bundle has 280 entries but runtime preallocates 200)",
      "status": "open",
