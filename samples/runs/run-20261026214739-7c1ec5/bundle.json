    "title": "Explicit shard grants for svc_bundle_reader",
    "files": [
      "db/migrations/0042_reader_shard_grants.sql"
    ],
    "diff": "--- /dev/null\n+++ b/db/migrations/0042_reader_shard_grants.sql\n@@ -0,0 +1,3 @@\n+-- Make the reader's access to shard databases explicit so per-principal\n+-- query limits and audit logging apply to it.\n+GRANT SELECT ON r0.* TO svc_bundle_reader;\n"
  },
  "verdict": {
    "verdict": "reproduced_failure",
    "headline": "Explicit shard grants for svc_bundle_reader breaks worker-runtime: 280 rows exceed max_entries=200 limit, causing worker to refuse to start",
    "cause": "The change adds GRANT SELECT ON r0.* TO svc_bundle_reader, making the principal's access to ALL tables in database r0 explicit rather than implicit. Previously the reader had access only to bundle_fields (140 rows). With the explicit grant, bundle-builder reads 280 rows (from all tables in r0), exceeding worker-runtime.max_entries=200, causing worker-runtime.exit_code=2 and refusal to start.",
    "decided_by": "deterministic_judge",
    "tested": [
      "x-f25cc122787342f8: baseline · workload default → all assertions passed",
      "x-7e3baa3f015549ba: candidate · workload default → failed: runtime_starts_with_bundle",
      "x-ac8a94f70d9946f2: candidate · workload default → failed: runtime_starts_with_bundle",
      "x-8fd4682c540f4510: control · workload default → all assertions passed"
    ],
    "limitations": [
      "Could not test whether svc_bundle_reader was previously restricted to bundle_fields only; the baseline experiment shows 140 rows visible",
      "which matches the bundle_fields table column count."
    ],
    "mitigation": {
      "text": "Restrict the grant to only the bundle_fields table: GRANT SELECT ON r0.bundle_fields TO svc_bundle_reader; instead of GRANT SELECT ON r0.* TO svc_bundle_reader;",
      "verified": false
    },
    "fix_verification": null
  },
