    "diff": "--- /dev/null\n+++ b/db/migrations/0042_reader_shard_grants.sql\n@@ -0,0 +1,4 @@\n+-- Make the reader's access to shard databases explicit so per-principal\n+-- query limits and audit logging apply to it.\n+GRANT SELECT ON r0.* TO svc_bundle_reader;\n+GRANT SELECT ON r1.* TO svc_bundle_reader;\n"
  },
  "verdict": {
    "verdict": "reproduced_failure",
    "headline": "Explicit shard grants for svc_bundle_reader break worker-runtime startup: bundle exceeds preallocated entry limit",
    "cause": "The change adds GRANT SELECT ON r0.* and GRANT SELECT ON r1.* to svc_bundle_reader. Baseline: rows_visible_to_builder = 60, bundle entries = 60, worker-runtime starts OK (exit 0). Candidate: rows_visible_to_builder = 180 (60 + 120 from shards), bundle entries = 180, bundle size 5629 bytes. Worker-runtime preallocates 160 entries; 180 > 160 causes exit code 2 (refuse to start).",
    "decided_by": "deterministic_judge",
    "tested": [
      "x-448cbec6a3d44c84: baseline · workload default → all assertions passed",
      "x-5108e87d916e414d: candidate · workload default → failed: runtime_starts_with_bundle",
      "x-af593eeb54b34a75: candidate · workload default → failed: runtime_starts_with_bundle",
      "x-5e417d767a314837: control · workload default → all assertions passed"
    ],
    "limitations": [
      "No experiment tested adjusting the runtime preallocation limit or filtering which tables the reader accesses. Only the default workload was tested."
    ],
    "mitigation": {
      "text": "Reduce the runtime preallocation from 160 to ≥180, or restrict the shard grants to only the tables needed (e.g., grant on specific tables rather than r0.*/r1.*) so rows_visible_to_builder stays ≤160.",
      "verified": false
    },
    "fix_verification": null
  },
