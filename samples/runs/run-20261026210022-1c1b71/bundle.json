  "hypotheses": [
    {
      "hypothesis_id": "h1",
      "claim": "Explicit shard grants for svc_bundle_reader cause worker-runtime to fail with exit code 2 because the bundle contains 180 entries, exceeding the runtime's preallocation limit of 160",
      "mechanism": "The GRANT SELECT ON r0.* and r1.* adds shard database access for svc_bundle_reader, which increases rows_visible_to_builder from 60 (baseline) to 180 (candidate). The bundle-builder reads 180 rows instead of 60, producing a 5629-byte bundle. Worker-runtime loads the bundle at startup and checks entry count against its preallocation of 160; 180 > 160 causes exit code 2 (refuse to start)",
      "status": "open",
