    "decided_by": "deterministic_judge",
    "tested": [
      "x-fa5c3a9ecc4e48b3: baseline · workload default → all assertions passed",
      "x-0bb3db5cd6874b02: candidate · workload default → failed: interpreter_keeps_running",
